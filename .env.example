# Copy to .env (ignored by git). Read by docker compose and by chess-reviewer.

# Chess.com asks every client of its public API for an explicit User-Agent
# with a way to contact its author. Required for the Chess.com reviews.
CHESS_REVIEW_USER_AGENT="chess-bot/0.1 (you@example.com)"

# NNUE lab API (/api/v1, documentation on /docs).
# Keys accepted in the X-API-Key header, comma-separated. Generate them, e.g.
# `openssl rand -hex 32`. Without any, every /api/v1 request is refused.
CHESS_API_KEYS=
# `disabled` lets anyone call /api/v1: local development only.
# CHESS_API_AUTH=disabled
# Requests per minute per key (0: no limit).
# CHESS_API_RATE_LIMIT=600
# Largest dataset upload, in MiB.
# CHESS_LAB_MAX_UPLOAD_MB=4096
# Shared by the server and its lab workers (`--profile train`); without it the
# workers' API is off. Generate it like the keys.
CHESS_LAB_WORKER_TOKEN=
