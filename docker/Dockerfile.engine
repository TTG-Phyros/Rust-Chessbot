# syntax=docker/dockerfile:1.7
#
# chess-server (HTTP/WebSocket API), chess-uci and chess-reviewer (Chess.com
# reviews from the command line), multi-arch (amd64, arm64), with Stockfish
# for the comparisons of the Play page and the game reviews.
#
#   docker build -f docker/Dockerfile.engine -t chess-bot/server .
#
# cargo-chef compiles the dependencies in their own layer, so editing the
# project's code does not rebuild axum, tokio & co.

ARG RUST_VERSION=1.99.1

FROM lukemathwalker/cargo-chef:latest-rust-${RUST_VERSION}-slim-trixie AS chef
ARG RUST_VERSION
# Pins the toolchain without the rustfmt/clippy components of rust-toolchain.toml.
ENV RUSTUP_TOOLCHAIN=${RUST_VERSION}
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json -p chess-server -p chess-uci -p chess-reviewer
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --release --locked -p chess-server -p chess-uci -p chess-reviewer \
    && cp target/release/chess-server target/release/chess-uci target/release/chess-reviewer \
       /usr/local/bin/

# ---------------------------------------------------------------- Stockfish
# Same build as the training image (see Dockerfile.train): the official
# "universal" binary, downloaded with retries and resume into a cache mount.
FROM debian:trixie-slim AS stockfish
ARG TARGETARCH
ARG STOCKFISH_VERSION=19
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/stockfish,sharing=locked \
    case "${TARGETARCH}" in \
      amd64) arch=x86-64 ;; \
      arm64) arch=arm64 ;; \
      *) echo "no Stockfish build for ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && archive=/root/.cache/stockfish/stockfish-${STOCKFISH_VERSION}-linux-${arch}.tar.gz \
    && if [ ! -f "$archive" ]; then \
         curl -fL --retry 10 --retry-all-errors --retry-delay 2 -C - -o "$archive.part" \
           "https://github.com/official-stockfish/Stockfish/releases/download/sf_${STOCKFISH_VERSION}/stockfish-linux-${arch}-universal.tar.gz" \
         && mv "$archive.part" "$archive"; \
       fi \
    && tar -xzf "$archive" -C /tmp "stockfish/stockfish-linux-${arch}-universal" \
    && install -m 755 "/tmp/stockfish/stockfish-linux-${arch}-universal" /usr/local/bin/stockfish \
    && printf 'uci\nquit\n' | stockfish | grep -q '^uciok'

FROM debian:trixie-slim AS runtime
ARG UID=10001
# CA certificates: the reviews call the Chess.com API over HTTPS.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# /cache holds the review cache (SQLite), /lab the NNUE lab's database and
# /datasets the training positions: a named volume mounted there takes the
# owner of this directory, so the unprivileged user can write to it.
RUN useradd --system --uid ${UID} --home-dir /data --shell /usr/sbin/nologin chess \
    && mkdir -p /data /cache /lab /datasets && chown chess /data /cache /lab /datasets
COPY --from=builder /usr/local/bin/chess-server /usr/local/bin/chess-uci \
     /usr/local/bin/chess-reviewer /usr/local/bin/
COPY --from=stockfish /usr/local/bin/stockfish /usr/local/bin/
USER chess
WORKDIR /data
ENV CHESS_SERVER_BIND=0.0.0.0:3000 \
    CHESS_SERVER_DATA_DIR=/data \
    CHESS_REVIEW_CACHE=/cache/review.sqlite
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["chess-server", "--healthcheck"]
ENTRYPOINT ["chess-server"]
