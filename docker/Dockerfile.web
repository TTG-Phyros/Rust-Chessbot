# syntax=docker/dockerfile:1.7
#
# Web UI: Vite build served by an unprivileged Nginx, which also proxies
# /api and /ws to chess-server (one origin, no CORS).
#
# The build output is plain static files, identical on every architecture, so
# the Node stage always runs on the build machine's native platform.

ARG NODE_VERSION=24

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 8080
